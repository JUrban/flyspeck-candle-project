#!/usr/bin/env python3
"""Narrow truncate helper for a restored Flyspeck PFT producer.

DMTCP can transiently report ECHILD to OCaml's Sys.command when a very short
post-restore child exits.  Perform the one supported boundary operation
directly and remain alive briefly so the restored parent can reap us normally.
"""

import os
import sys
import time


def main(argv):
    if len(argv) != 5 or argv[1] != "-s" or argv[3] != "--":
        print("usage: truncate -s NONNEGATIVE_BYTES -- PATH", file=sys.stderr)
        return 2
    try:
        size = int(argv[2], 10)
    except ValueError:
        print("truncate: size must be a base-10 integer", file=sys.stderr)
        return 2
    if size < 0:
        print("truncate: size must be nonnegative", file=sys.stderr)
        return 2

    path = argv[4]
    with open(path, "r+b", buffering=0) as stream:
        stream.truncate(size)
        os.fsync(stream.fileno())

    delay_text = os.environ.get("CANDLE_PFT_TRUNCATE_SETTLE_SECONDS", "1.0")
    try:
        delay = float(delay_text)
    except ValueError:
        print("truncate: invalid settle delay", file=sys.stderr)
        return 2
    if delay < 0.0 or delay > 10.0:
        print("truncate: settle delay must be between 0 and 10 seconds", file=sys.stderr)
        return 2
    time.sleep(delay)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
